# ============================================================
# SecScanner — Variables de Entorno
# Copia este archivo como .env y rellena los valores
# NUNCA subas .env a GitHub
# ============================================================

# ── Base de Datos ────────────────────────────────────────────
# Local (SQLite — por defecto, sin configuración):
# DATABASE_URL=sqlite:///./data/scans.db
#
# Producción (Supabase PostgreSQL — pegar el connection string de Supabase):
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Seguridad JWT ────────────────────────────────────────────
# Generar con: openssl rand -hex 32
SECRET_KEY=cambiar-por-clave-segura-de-64-caracteres

# ── CORS ─────────────────────────────────────────────────────
# Local: dejar como * o vacío
# Producción: URL de Vercel (sin barra final)
ALLOWED_ORIGINS=https://tu-proyecto.vercel.app

# ── Usuario Admin Inicial ────────────────────────────────────
AUTH_USERNAME=admin
AUTH_PASSWORD=CambiarEstaContrasena2024!

# ── VirusTotal (opcional) ────────────────────────────────────
# Obtener en: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
